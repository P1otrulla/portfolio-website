# --- Wymagane ---
# Losowy, długi sekret (np. `openssl rand -hex 32`). Podpisuje sesje panelu /admin.
PAYLOAD_SECRET=zmien-mnie-na-dlugi-losowy-ciag

# Przy `docker compose up` ustawiane automatycznie. Dla `npm run dev` z bazą z dockera:
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio

# Publiczny adres strony (linki w sitemap, OG, JSON-LD)
SITE_URL=http://localhost:3000

# --- Opinie Google (opcjonalne) ---
# Klucz Google Maps Platform z włączonym "Places API (New)".
# Place ID wpisujesz w panelu: Ustawienia strony -> Opinie Google.
GOOGLE_PLACES_API_KEY=

# Przy pierwszym starcie wypełnia CMS przykładowymi danymi (gdy baza jest pusta).
SEED_ON_INIT=true
